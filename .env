# --- Database -------------------------------------------------------------
# PostgreSQL connection string. Set this to your Vercel Postgres, Neon, or
# local PostgreSQL URL. Override in .env.local for local development.
DATABASE_URL="postgresql://user:pass@localhost:5432/vittora?schema=public"

# --- Auth -----------------------------------------------------------------
# Secret used to sign the session cookie. Change this in production.
AUTH_SECRET="dev-only-change-me-in-production-please-32chars-minimum"

# Development credentials (swap for a real identity provider later).
DEV_AUTH_USERNAME="admin"
DEV_AUTH_PASSWORD="admin123"
