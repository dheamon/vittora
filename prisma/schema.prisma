generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ClientType {
  INDIVIDUAL
  COMPANY
}

model Client {
  id   String     @id @default(cuid())
  type ClientType @default(INDIVIDUAL)

  // --- Basic details ---
  name    String
  pan     String  @unique // Permanent Account Number — always unique.
  password String? // The client's income-tax portal login password.
  aadhaar String?
  dob     String? // Date of birth (individuals), stored as DD/MM/YYYY.
  dof     String? // Date of formation (companies), stored as DD/MM/YYYY.
  phone   String?
  email   String?
  address String?

  // --- Tax & portal ---
  gstNumber      String?
  userId         String? // Portal user ID.
  portalPassword String?

  // --- Auto-generated ---
  // AIS password = PAN + DOB (digits only). Regenerated whenever PAN/DOB change.
  aisPassword String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([type])
  @@index([createdAt])
  @@index([updatedAt])
}
